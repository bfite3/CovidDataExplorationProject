"""
Test the SQL execution utility without
modifying existing database tables.
"""

import os
from pathlib import Path

import pyodbc

from sql_runner import execute_sql_file


ROOT = Path(__file__).resolve().parents[1]

SERVER = os.environ.get(
    "COVID_SQL_SERVER",
    r"DESKTOP-KP36Q46\SQLEXPRESS",
)

connection_string = (
    "DRIVER={ODBC Driver 18 for SQL Server};"
    f"SERVER={SERVER};"
    "DATABASE=CovidPortfolioProject;"
    "Trusted_Connection=yes;"
    "TrustServerCertificate=yes;"
)

with pyodbc.connect(connection_string) as connection:
    execute_sql_file(
        connection,
        ROOT / "sql" / "11_test_connection.sql",
    )

print("SQL execution test completed successfully.")